# Compile
CONFIG_USE_APK=n
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_TELNET=y

# Proto
CONFIG_PACKAGE_proto-bonding=y
CONFIG_PACKAGE_luci-proto-wireguard=y
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl-legacy=y

# Disable Package
CONFIG_PACKAGE_automount=n

#  DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

#  Coremark
CONFIG_PACKAGE_coremark=y
CONFIG_COREMARK_OPTIMIZE_O3=y
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=6

#  iptables nft
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y

# Package
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_tcpdump=y

# Enable Luci App
CONFIG_PACKAGE_luci-app-vantage=y
CONFIG_PACKAGE_luci-app-netwiz=y
CONFIG_PACKAGE_luci-i18n-netwiz-zh-cn=y
CONFIG_PACKAGE_luci-app-pbr=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-wol=y

# Fork policy: excluded applications
CONFIG_PACKAGE_easytier=n
CONFIG_PACKAGE_kmod-oaf=n
CONFIG_PACKAGE_luci-app-easytier=n
CONFIG_PACKAGE_luci-app-lucky=n
CONFIG_PACKAGE_luci-app-mosdns=n
CONFIG_PACKAGE_luci-app-oaf=n
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=n
CONFIG_PACKAGE_luci-i18n-lucky-zh-cn=n
CONFIG_PACKAGE_luci-i18n-mosdns-zh-cn=n
CONFIG_PACKAGE_luci-i18n-oaf-zh-cn=n
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=n
CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn=n
CONFIG_PACKAGE_lucky=n
CONFIG_PACKAGE_mosdns=n
CONFIG_PACKAGE_oaf=n
CONFIG_PACKAGE_open-app-filter=n
CONFIG_PACKAGE_smartdns=n
